# Скопіюй цей файл як .env і заповни своїми даними

# Токен від @BotFather в Telegram (ОБОВ'ЯЗКОВО)
BOT_TOKEN=your_telegram_bot_token_here

# Ключ Anthropic для AI аналізу (необов'язково)
# Реєстрація: console.anthropic.com
ANTHROPIC_API_KEY=your_anthropic_key_here

# Ключ Auto.ria API (необов'язково, без нього — HTML парсинг)
# Реєстрація: developers.auto.ria.com
AUTORIA_API_KEY=your_autoria_key_here
